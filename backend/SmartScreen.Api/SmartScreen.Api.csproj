<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SmartScreen.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="9.0.9" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <FrontendDir>$(MSBuildProjectDirectory)\..\..\frontend</FrontendDir>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="uploads\**" />
    <None Remove="uploads\**" />
    <!-- Build-i i React shtohet në publish nga target-i BuildFrontend më poshtë -->
    <Content Remove="wwwroot\app\**" />
    <None Remove="wwwroot\app\**" />
  </ItemGroup>

  <!--
    Gjatë publish (dotnet publish ose Visual Studio → Publish) ndërtohet automatikisht frontend-i
    React dhe kopjohet në wwwroot/app. Për ta kapërcyer: -p:SkipFrontend=true
  -->
  <Target Name="BuildFrontend" BeforeTargets="ComputeResolvedFilesToPublishList" Condition="'$(SkipFrontend)' != 'true'">
    <!-- npm install (jo vetëm kur mungon node_modules), që paketat e reja të instalohen edhe pas git pull -->
    <Exec WorkingDirectory="$(FrontendDir)" Command="npm install --no-audit --no-fund --loglevel=error" />
    <Exec WorkingDirectory="$(FrontendDir)" Command="npm run build" />
    <ItemGroup>
      <FrontendFiles Include="wwwroot\app\**" />
      <ResolvedFileToPublish Include="@(FrontendFiles->'%(FullPath)')">
        <RelativePath>%(FrontendFiles.Identity)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
